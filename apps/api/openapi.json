  "info": {
    "title": "VSCoke API",
    "description": "VSCoke API 문서입니다.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthCheckResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "uptime": {
            "type": "number",
            "description": "API process uptime in seconds",
            "example": 123.45
          },
          "timestamp": {
            "type": "string",
            "description": "Health check response time in ISO 8601 format",
            "example": "2026-07-05T00:00:00.000Z"
          }
        },
        "required": ["status", "uptime", "timestamp"]
      },
      "EspressoEquipmentDto": {
        "type": "object",
        "properties": {
          "machine": {
            "type": "string",
            "description": "에스프레소 머신",
            "example": "CRM 3605 PWM 2버전"
          },
          "grinder": {
            "type": "string",
            "description": "그라인더",
            "example": "DF64 Gen2"
          },
          "basket": {
            "type": "string",
            "description": "바스켓",
            "example": "IMS 20g"
          },
          "dosingShaker": {
            "type": "string",
            "description": "도징 쉐이커",
            "example": "도징쉐이커"
          },
          "tamper": {
            "type": "string",
            "description": "탬퍼",
            "example": "58.5mm tamper"
          }
        }
      },
      "EspressoMeasurementDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "description": "단일 측정값",
            "example": 20
          },
          "min": {
            "type": "number",
            "description": "범위 최소값",
            "example": 25
          },
          "max": {
            "type": "number",
            "description": "범위 최대값",
            "example": 30
          },
          "unit": {
            "type": "string",
            "enum": ["g", "sec", "celsius", "bar"],
            "description": "측정 단위",
            "example": "g"
          }
        },
        "required": ["unit"]
      },
      "EspressoRecipeParametersDto": {
        "type": "object",
        "properties": {
          "dose": {
            "$ref": "#/components/schemas/EspressoMeasurementDto"
          },
          "yield": {
            "$ref": "#/components/schemas/EspressoMeasurementDto"
          },
          "temperature": {
            "$ref": "#/components/schemas/EspressoMeasurementDto"
          },
          "preinfusion": {
            "$ref": "#/components/schemas/EspressoMeasurementDto"
          },
          "extractionTime": {
            "$ref": "#/components/schemas/EspressoMeasurementDto"
          },
          "targetExtractionTime": {
            "$ref": "#/components/schemas/EspressoMeasurementDto"
          },
          "pressure": {
            "$ref": "#/components/schemas/EspressoMeasurementDto"
          },
          "flow": {
            "type": "string",
            "description": "유량 조건",
            "example": "기본 유량"
          },
          "grind": {
            "type": "string",
            "description": "분쇄도 조건",
            "example": "2.4"
          }
        }
      },
      "EspressoResultDto": {
        "type": "object",
        "properties": {
          "extractionTime": {
            "$ref": "#/components/schemas/EspressoMeasurementDto"
          },
          "pressure": {
            "$ref": "#/components/schemas/EspressoMeasurementDto"
          },
          "taste": {
            "description": "맛 기록",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "description": "추가 메모",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EspressoRoundAnalysisDto": {
        "type": "object",
        "properties": {
          "changes": {
            "description": "변경 사항",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "description": "기록 메모",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "judgments": {
            "description": "판단",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inferences": {
            "description": "추론",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conclusions": {
            "description": "결론",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "plannedComparisons": {
            "description": "비교 예정 항목",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EspressoRoundResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "라운드 ID",
            "example": "round-1"
          },
          "roundNumber": {
            "type": "number",
            "description": "라운드 번호",
            "example": 1
          },
          "date": {
            "type": "string",
            "nullable": true,
            "description": "추출 일자",
            "example": "2026-06-16"
          },
          "recipe": {
            "description": "추출 레시피",
            "allOf": [
              {
                "$ref": "#/components/schemas/EspressoRecipeParametersDto"
              }
            ]
          },
          "result": {
            "description": "추출 결과",
            "allOf": [
              {
                "$ref": "#/components/schemas/EspressoResultDto"
              }
            ]
          },
          "analysis": {
            "description": "라운드 분석",
            "allOf": [
              {
                "$ref": "#/components/schemas/EspressoRoundAnalysisDto"
              }
            ]
          },
          "nextActions": {
            "description": "다음 액션",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "roundNumber", "recipe", "result", "nextActions"]
      },
      "EspressoCurrentAnalysisDto": {
        "type": "object",
