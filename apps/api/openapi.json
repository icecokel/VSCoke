    "/main-chat": {
      "post": {
        "operationId": "MainChatController_chat",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeRagChatRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "headers": {
              "X-RateLimit-Limit": {
                "description": "IP당 1시간 메인 채팅 요청 최대 횟수",
                "schema": {
                  "type": "integer",
                  "example": 30
                }
              },
              "X-RateLimit-Remaining": {
                "description": "현재 IP에서 남은 메인 채팅 요청 횟수",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "X-RateLimit-Reset": {
                "description": "다음 메인 채팅 요청 횟수가 복구되는 Unix epoch 초",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/ResumeRagChatResponseDto"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "질문 길이 또는 locale 형식이 올바르지 않음"
          },
          "403": {
            "description": "허용된 VSCoke 웹 origin이 아닌 요청"
          },
          "429": {
            "description": "IP당 1시간에 허용된 메인 채팅 요청 횟수를 초과함",
            "headers": {
              "X-RateLimit-Limit": {
                "description": "IP당 1시간 메인 채팅 요청 최대 횟수",
                "schema": {
                  "type": "integer",
                  "example": 30
                }
              },
              "X-RateLimit-Remaining": {
                "description": "현재 IP에서 남은 메인 채팅 요청 횟수",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "X-RateLimit-Reset": {
                "description": "다음 메인 채팅 요청 횟수가 복구되는 Unix epoch 초",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "분류되지 않은 서버 오류"
          },
          "503": {
            "description": "검색 또는 답변 생성 공급자를 사용할 수 없음"
          }
        },
        "summary": "프로젝트와 이력서 통합 질문 답변",
        "tags": ["Main Chat"]
      }
    },
