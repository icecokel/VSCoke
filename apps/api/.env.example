# Runtime.
NODE_ENV=development
PORT=3000

# API access logs use daily-rotated logs/combined-*.log files retained for 180 days.
# Each HTTP response includes X-Request-Id for log correlation.
# Optional: error, warn, info, http, verbose, debug, or silly.
# Unset/blank uses info in production, debug otherwise. Invalid values fail startup.
# LOG_LEVEL=info

# CORS.
# Add production and preview web origins as comma-separated exact origins.
CORS_ORIGINS=https://vscoke.icecoke.kr,http://localhost:3000,http://127.0.0.1:3000

# Google OAuth token verification.
GOOGLE_CLIENT_ID=replace-with-google-client-id

# PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-db-password
DB_DATABASE=vscoke
DB_SYNCHRONIZE=false

# Optional production error notification endpoint.
# If any value is empty, notification delivery is skipped.
NOTIFY_SERVICE_URL=
NOTIFY_SERVICE_USER=
NOTIFY_SERVICE_PASSWORD=

# Development-only auth bypass. Do not set in production.
ENABLE_DEV_AUTH_BYPASS=false
DEV_AUTH_TOKEN=

# Local database tunnel helper: pnpm --filter @vscoke/api db:tunnel
CLOUDFLARE_DB_HOST=

# Resume RAG.
# 기본은 키워드 + 벡터 하이브리드 검색이다. 벡터 장애 시 키워드 검색으로 대체한다.
# 벡터 검색에는 아래 임베딩 설정과 resume:index 실행이 필요하다.
RAG_RETRIEVAL_MODE=hybrid
RAG_VECTOR_MIN_SIMILARITY=0.3
# 공급자가 dimensions 요청 파라미터를 지원할 때만 true로 설정한다.
RAG_EMBEDDING_SEND_DIMENSIONS=false
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=

# Required for natural-language answer generation.
RAG_CHAT_PROVIDER=codex-app-server
# Optional. If empty, Codex app-server uses its configured default model.
RAG_CHAT_MODEL=
RAG_CODEX_MODEL_PROVIDER=
# Ubuntu host default: Codex app-server loopback endpoint.
RAG_CODEX_APP_SERVER_URL=ws://127.0.0.1:14561
# Public chat Codex threads use an isolated working directory.
RAG_CODEX_CWD=/home/icenux/projects/vscoke-codex-sandbox
RAG_CODEX_TIMEOUT_MS=120000
# Codex app-server turn reasoning effort. Defaults to low when omitted.
RAG_CODEX_REASONING_EFFORT=low

# Public chat browser-origin allowlist.
# Production default is https://vscoke.icecoke.kr. Set explicitly in operation.
RAG_PUBLIC_CHAT_ORIGINS=https://vscoke.icecoke.kr

# openai-compatible 임베딩 생성·질문 벡터 검색 또는 해당 chat provider에 필요하다.
RAG_AI_BASE_URL=
RAG_AI_API_KEY=

RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.1
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=120
RAG_ALLOWED_VISIBILITIES=public
RAG_ALLOWED_SOURCE_TYPES=app_resume

# 서버 내부 E5 임베딩: provider=local-e5-q8, model=repository@commit-sha
# 운영 캐시는 rsync --delete 대상 release 바깥에 둔다.
RAG_LOCAL_EMBEDDING_CACHE_DIR=
# 최초 사전 다운로드/인덱싱 후 true로 바꾸면 런타임 모델 다운로드를 차단한다.
RAG_LOCAL_EMBEDDING_LOCAL_FILES_ONLY=false
