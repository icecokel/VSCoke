    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "서버가 정상적으로 동작 중임을 나타내는 메시지",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "type": "string",
                      "example": "Hello World!"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "서버 상태 확인",
        "tags": ["App"]
      }
    },
